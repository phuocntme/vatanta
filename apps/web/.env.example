# apps/web — copy to .env.local
# Privy app id (https://dashboard.privy.io → create app → allow origin http://localhost:4001).
# Enables login with Core / Rabby / MetaMask / WalletConnect wallets and email / Google / X embedded wallets.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_NETWORK=local
NEXT_PUBLIC_RELAYER_URL=http://127.0.0.1:8080
NEXT_PUBLIC_INDEXER_URL=http://127.0.0.1:8081
