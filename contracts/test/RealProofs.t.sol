pragma solidity ^0.8.27;

import {Test} from "forge-std/Test.sol";
import {stdJson} from "forge-std/StdJson.sol";
import {ShieldedPool} from "../src/ShieldedPool.sol";
import {VerifierRegistry} from "../src/VerifierRegistry.sol";
import {IERC20Like} from "../src/interfaces/IERC20Like.sol";
import {IHonkVerifier} from "../src/interfaces/IHonkVerifier.sol";
import {TransferVerifier} from "../src/verifiers/TransferVerifier.sol";
import {SplitVerifier} from "../src/verifiers/SplitVerifier.sol";
import {WithdrawVerifier} from "../src/verifiers/WithdrawVerifier.sol";
import {MockTokenRemote} from "./utils/Mocks.sol";

/// Real UltraHonk proofs (generated by `pnpm --filter sdk fixtures script, sdk/scripts/gen-fixtures.ts) vs the real
/// generated verifiers. Covers required invariant (c): a proof with a tampered recipient, fee or
/// relayer (or chain, pool, ciphertext) is rejected.
contract RealProofsTest is Test {
    using stdJson for string;

    bytes32 constant HOME_ID = bytes32(uint256(0xC0C0));
    address constant TOKEN_HOME = address(0x40E1);
    address constant ROUTER = address(0x2007E2);

    string json;
    ShieldedPool pool;
    VerifierRegistry registry;
    MockTokenRemote remote;
    address relayer;
    bytes32 vkT;
    bytes32 vkS;
    bytes32 vkW;

    function setUp() public {
        json = vm.readFile("test/fixtures/flow.json");
        vm.chainId(json.readUint(".chainId"));
        relayer = json.readAddress(".relayer");
        vkT = json.readBytes32(".vkTransfer");
        vkS = json.readBytes32(".vkSplit");
        vkW = json.readBytes32(".vkWithdraw");
        remote = new MockTokenRemote();
        registry = new VerifierRegistry(address(this));
        registry.register(vkT, IHonkVerifier(address(new TransferVerifier())), "transfer");
        registry.register(vkS, IHonkVerifier(address(new SplitVerifier())), "split");
        registry.register(vkW, IHonkVerifier(address(new WithdrawVerifier())), "withdraw");
        pool = _deployPoolAt(json.readAddress(".pool"));
        _replayDeposits(pool);
    }

    function _deployPoolAt(address at) internal returns (ShieldedPool p) {
        deployCodeTo(
            "ShieldedPool.sol:ShieldedPool",
            abi.encode(IERC20Like(address(remote)), HOME_ID, TOKEN_HOME, ROUTER, registry, vkT, vkS, vkW),
            at
        );
        p = ShieldedPool(at);
    }

    function _replayDeposits(ShieldedPool p) internal {
        uint256[] memory amounts = json.readUintArray(".depositAmounts");
        uint256[] memory pres = json.readUintArray(".depositPrecommits");
        for (uint256 i = 0; i < amounts.length; i++) {
            bool ok = remote.deliver(HOME_ID, TOKEN_HOME, ROUTER, address(p), amounts[i], abi.encode(pres[i]), address(0xFA11));
            require(ok, "deposit failed");
        }
    }

    // ------------------------------------------------------------------ fixture decoding
    function _transfer() internal view returns (bytes memory proof, ShieldedPool.TransferArgs memory a) {
        proof = json.readBytes(".transferProof");
        a.root = json.readUint(".transfer.root");
        uint256[] memory n = json.readUintArray(".transfer.nullifiers");
        uint256[] memory c = json.readUintArray(".transfer.commitments");
        a.nullifiers = [n[0], n[1]];
        a.commitments = [c[0], c[1]];
        a.fee = json.readUint(".transfer.fee");
        a.relayer = json.readAddress(".transfer.relayer");
        for (uint256 i = 0; i < 2; i++) {
            string memory k = string.concat(".transfer.notes[", vm.toString(i), "]");
            a.notes[i] = ShieldedPool.NoteData(json.readBytes(string.concat(k, ".ciphertext")), uint8(json.readUint(string.concat(k, ".viewTag"))));
        }
    }

    function _split() internal view returns (bytes memory proof, ShieldedPool.SplitArgs memory a) {
        proof = json.readBytes(".splitProof");
        a.root = json.readUint(".split.root");
        uint256[] memory n = json.readUintArray(".split.nullifiers");
        a.nullifiers = [n[0], n[1]];
        uint256[] memory d = json.readUintArray(".split.denomCommitments");
        for (uint256 i = 0; i < 12; i++) a.denomCommitments[i] = d[i];
        a.changeCommitment = json.readUint(".split.changeCommitment");
        a.fee = json.readUint(".split.fee");
        a.relayer = json.readAddress(".split.relayer");
        for (uint256 i = 0; i < 13; i++) {
            string memory k = string.concat(".split.notes[", vm.toString(i), "]");
            a.notes[i] = ShieldedPool.NoteData(json.readBytes(string.concat(k, ".ciphertext")), uint8(json.readUint(string.concat(k, ".viewTag"))));
        }
    }

    function _withdraw() internal view returns (bytes memory proof, ShieldedPool.WithdrawArgs memory a) {
        proof = json.readBytes(".withdrawProof");
        a.root = json.readUint(".withdraw.root");
        a.nullifier = json.readUint(".withdraw.nullifier");
        a.amount = json.readUint(".withdraw.amount");
        a.recipient = json.readAddress(".withdraw.recipient");
        a.relayer = json.readAddress(".withdraw.relayer");
    }

    function _withdrawL1() internal view returns (bytes memory proof, ShieldedPool.WithdrawArgs memory a) {
        proof = json.readBytes(".withdrawL1Proof");
        a.root = json.readUint(".withdrawL1.root");
        a.nullifier = json.readUint(".withdrawL1.nullifier");
        a.amount = json.readUint(".withdrawL1.amount");
        a.recipient = json.readAddress(".withdrawL1.recipient");
        a.relayer = json.readAddress(".withdrawL1.relayer");
        a.destBlockchainId = json.readBytes32(".withdrawL1.destBlockchainId");
        a.destTransferrer = json.readAddress(".withdrawL1.destTransferrer");
    }

    function _toSplit() internal {
        (bytes memory tp, ShieldedPool.TransferArgs memory ta) = _transfer();
        pool.transfer(tp, ta);
        (bytes memory sp, ShieldedPool.SplitArgs memory sa) = _split();
        pool.split(sp, sa);
    }

    // ------------------------------------------------------------------ withdraw to another L1 (§14)
    function test_withdraw_to_l1_with_real_proof() public {
        _toSplit();
        (bytes memory p, ShieldedPool.WithdrawArgs memory a) = _withdrawL1();
        assertTrue(a.destBlockchainId != bytes32(0), "fixture has a destination");
        uint256 g = gasleft();
        pool.withdraw(p, a);
        emit log_named_uint("gas: withdraw to L1 (real proof)", g - gasleft());
        (bytes32 dest, address destT, address rcpt, uint256 amt,, address fb) = remote.sent(0);
        assertEq(dest, a.destBlockchainId);
        assertEq(destT, a.destTransferrer);
        assertEq(rcpt, a.recipient);
        assertEq(fb, a.recipient);
        assertEq(amt, 99.75e6);
    }

    function test_c_tampered_withdraw_destination_rejected() public {
        _toSplit();
        (bytes memory p, ShieldedPool.WithdrawArgs memory a) = _withdrawL1();
        a.destBlockchainId = bytes32(uint256(0xBAD)); // relayer redirects to another L1
        vm.expectRevert(); // verifier reverts (SumcheckFailed) or returns false
        pool.withdraw(p, a);
        (p, a) = _withdrawL1();
        a.destTransferrer = address(0xBAD); // or to another TokenRemote
        vm.expectRevert(); // verifier reverts (SumcheckFailed) or returns false
        pool.withdraw(p, a);
        (p, a) = _withdrawL1();
        a.destBlockchainId = bytes32(0); // or back to C-Chain
        a.destTransferrer = address(0);
        vm.expectRevert(); // verifier reverts (SumcheckFailed) or returns false
        pool.withdraw(p, a);
    }

    function test_c_chain_withdraw_proof_cannot_be_sent_to_an_l1() public {
        _toSplit();
        (bytes memory p, ShieldedPool.WithdrawArgs memory a) = _withdraw();
        a.destBlockchainId = bytes32(uint256(0xEC40));
        a.destTransferrer = address(0xEC0);
        vm.expectRevert(); // verifier reverts (SumcheckFailed) or returns false
        pool.withdraw(p, a);
    }

    // ------------------------------------------------------------------ happy path
    function test_roots_match_sdk() public view {
        (, ShieldedPool.TransferArgs memory a) = _transfer();
        assertEq(pool.currentRoot(), a.root, "SDK tree == on-chain tree after deposits");
    }

    function test_full_flow_with_real_proofs() public {
        (bytes memory tp, ShieldedPool.TransferArgs memory ta) = _transfer();
        uint256 g = gasleft();
        pool.transfer(tp, ta);
        emit log_named_uint("gas: transfer (real proof)", g - gasleft());
        assertEq(remote.balanceOf(relayer), 0.1e6);

        (bytes memory sp, ShieldedPool.SplitArgs memory sa) = _split();
        assertEq(pool.currentRoot(), sa.root, "split root");
        g = gasleft();
        pool.split(sp, sa);
        emit log_named_uint("gas: split 9 pieces (real proof)", g - gasleft());

        (bytes memory wp, ShieldedPool.WithdrawArgs memory wa) = _withdraw();
        g = gasleft();
        pool.withdraw(wp, wa);
        emit log_named_uint("gas: withdraw (real proof)", g - gasleft());
        (,, address rcpt, uint256 amt,,) = remote.sent(0);
        assertEq(rcpt, address(0xC0FFEE));
        assertEq(amt, 99.75e6);
        assertEq(remote.balanceOf(relayer), 0.1e6 + 0.1e6 + 0.25e6);
    }

    function test_old_root_still_accepted_for_delayed_withdraw() public {
        (bytes memory tp, ShieldedPool.TransferArgs memory ta) = _transfer();
        pool.transfer(tp, ta);
        (bytes memory sp, ShieldedPool.SplitArgs memory sa) = _split();
        pool.split(sp, sa);
        // more activity moves the root on; the withdraw proof's root is from 20h ago
        vm.warp(block.timestamp + 20 hours);
        remote.deliver(HOME_ID, TOKEN_HOME, ROUTER, address(pool), 9.975e6, abi.encode(uint256(5)), address(1));
        (bytes memory wp, ShieldedPool.WithdrawArgs memory wa) = _withdraw();
        pool.withdraw(wp, wa);
    }

    // ------------------------------------------------------------------ (c) tampering
    function test_c_tampered_transfer_relayer_rejected() public {
        (bytes memory p, ShieldedPool.TransferArgs memory a) = _transfer();
        a.relayer = address(0xBAD);
        vm.expectRevert();
        pool.transfer(p, a);
    }

    function test_c_tampered_transfer_fee_rejected() public {
        (bytes memory p, ShieldedPool.TransferArgs memory a) = _transfer();
        a.fee = 0.2e6;
        vm.expectRevert(ShieldedPool.WrongFee.selector);
        pool.transfer(p, a);
        // and the proof itself does not verify for any other fee value
        bytes32[] memory pi = _transferPI(a);
        pi[5] = bytes32(uint256(0.2e6));
        _assertRejected(vkT, p, pi);
    }

    function test_c_tampered_ciphertext_rejected() public {
        (bytes memory p, ShieldedPool.TransferArgs memory a) = _transfer();
        a.notes[0].ciphertext[40] = bytes1(uint8(a.notes[0].ciphertext[40]) ^ 1);
        vm.expectRevert();
        pool.transfer(p, a);
    }

    function test_c_tampered_output_rejected() public {
        (bytes memory p, ShieldedPool.TransferArgs memory a) = _transfer();
        a.commitments[0] = a.commitments[0] ^ 1;
        vm.expectRevert();
        pool.transfer(p, a);
    }

    function test_c_tampered_withdraw_recipient_rejected() public {
        (bytes memory tp, ShieldedPool.TransferArgs memory ta) = _transfer();
        pool.transfer(tp, ta);
        (bytes memory sp, ShieldedPool.SplitArgs memory sa) = _split();
        pool.split(sp, sa);
        (bytes memory p, ShieldedPool.WithdrawArgs memory a) = _withdraw();
        a.recipient = address(0xA77AC);
        vm.expectRevert();
        pool.withdraw(p, a);
    }

    function test_c_tampered_withdraw_relayer_rejected() public {
        (bytes memory tp, ShieldedPool.TransferArgs memory ta) = _transfer();
        pool.transfer(tp, ta);
        (bytes memory sp, ShieldedPool.SplitArgs memory sa) = _split();
        pool.split(sp, sa);
        (bytes memory p, ShieldedPool.WithdrawArgs memory a) = _withdraw();
        a.relayer = address(0xA77AC);
        vm.expectRevert();
        pool.withdraw(p, a);
    }

    function test_c_tampered_split_relayer_rejected() public {
        (bytes memory tp, ShieldedPool.TransferArgs memory ta) = _transfer();
        pool.transfer(tp, ta);
        (bytes memory p, ShieldedPool.SplitArgs memory a) = _split();
        a.relayer = address(0xA77AC);
        vm.expectRevert();
        pool.split(p, a);
    }

    function test_c_other_chain_rejected() public {
        (bytes memory p, ShieldedPool.TransferArgs memory a) = _transfer();
        vm.chainId(43113);
        vm.expectRevert();
        pool.transfer(p, a);
    }

    function test_c_other_pool_rejected() public {
        // identical state at another address: the proof is bound to the original pool
        ShieldedPool other = _deployPoolAt(address(0x0712E2));
        _replayDeposits(other);
        (bytes memory p, ShieldedPool.TransferArgs memory a) = _transfer();
        assertEq(other.currentRoot(), a.root);
        vm.expectRevert();
        other.transfer(p, a);
    }

    function test_b_real_proof_replay_rejected() public {
        (bytes memory p, ShieldedPool.TransferArgs memory a) = _transfer();
        pool.transfer(p, a);
        vm.expectRevert(abi.encodeWithSelector(ShieldedPool.NullifierAlreadySpent.selector, a.nullifiers[0]));
        pool.transfer(p, a);
    }

    // ------------------------------------------------------------------ helpers
    function _transferPI(ShieldedPool.TransferArgs memory a) internal view returns (bytes32[] memory pi) {
        ShieldedPool.NoteData[] memory n = new ShieldedPool.NoteData[](2);
        n[0] = a.notes[0];
        n[1] = a.notes[1];
        pi = new bytes32[](10);
        pi[0] = bytes32(a.root);
        pi[1] = bytes32(a.nullifiers[0]);
        pi[2] = bytes32(a.nullifiers[1]);
        pi[3] = bytes32(a.commitments[0]);
        pi[4] = bytes32(a.commitments[1]);
        pi[5] = bytes32(a.fee);
        pi[6] = bytes32(uint256(uint160(a.relayer)));
        pi[7] = bytes32(block.chainid);
        pi[8] = bytes32(uint256(uint160(address(pool))));
        pi[9] = bytes32(pool.extDataHash(n));
    }

    function _assertRejected(bytes32 vk, bytes memory proof, bytes32[] memory pi) internal view {
        try registry.verify(vk, proof, pi) returns (bool ok) {
            assertFalse(ok, "tampered proof accepted");
        } catch {}
    }

    function test_c_untampered_public_inputs_verify() public view {
        (bytes memory p, ShieldedPool.TransferArgs memory a) = _transfer();
        assertTrue(registry.verify(vkT, p, _transferPI(a)));
    }
}
