# ─── Vatanta on Fuji ────────────────────────────────────────────────────────────────────────────
# Fill these, then:   l1/fuji/up.sh  &&  scripts/fuji-local.sh up        (docs/fuji-local.md)
# On a VPS later: same file with public URLs, see docs/deploy-vps.md.
# NEVER commit the filled file. Keys are read from the environment only.

NETWORK=fuji
# avalanche-cli name of the Fuji L1 config (the "vatanta" config is the local one, ewoq key)
L1_NAME=vatantafuji

# Funded Fuji key used once to deploy contracts (needs C-Chain AVAX and gas on the L1).
DEPLOYER_PK=
# Hot key of the relayer service (needs a little C-Chain AVAX for deposits and L1 gas token for submits).
# Fill it BEFORE l1/fuji/up.sh: its address then gets VNT (L1 gas) in the genesis allocation.
RELAYER_PK=

# RPCs
C_RPC=https://api.avax-test.network/ext/bc/C/rpc
# Your L1 validator/RPC node, e.g. https://rpc.vatanta.example/ext/bc/<blockchainID-cb58>/rpc
L1_RPC=

# Blockchain IDs (hex). Leave empty to read them from the warp precompile automatically.
C_BLOCKCHAIN_ID=
L1_BLOCKCHAIN_ID=

# ICM (Teleporter) registries. Fuji C-Chain registry per Avalanche docs; L1 registry is printed by
# `avalanche blockchain describe vatanta` after l1/fuji/up.sh.
C_ICM_REGISTRY=0xF86Cb19Ad8405AEFa7d09C778215D2Cb6eBfB228
L1_ICM_REGISTRY=

# Circle USDC on Fuji (EIP-2612 permit verified). Leave empty to deploy a MockUSDC instead.
USDC=0x5425890298aed601595a70AB815c96711a31Bc65

# Off-chain services
# left as change-me, scripts/fuji-local.sh generates one and keeps it in .run/fuji-pg-password
POSTGRES_PASSWORD=change-me
BATCH_INTERVAL_SECS=600
FAUCET=0
PUBLIC_RELAYER_URL=https://relayer.vatanta.example
PUBLIC_INDEXER_URL=https://indexer.vatanta.example
PUBLIC_L1_RPC=
PUBLIC_C_RPC=https://api.avax-test.network/ext/bc/C/rpc
# Privy app id (dashboard.privy.io): login with Core / MetaMask / WalletConnect or email/Google embedded wallet.
# Allow your web origin in the Privy dashboard.
PRIVY_APP_ID=
# Host the web app is served from, e.g. app.vatanta.xyz. MetaMask / Core users sign a Sign-In with
# Ethereum message bound to it, and their shielded keys depend on it: set it once, never change it.
# Empty = whatever host the page is opened on (fine for localhost).
APP_DOMAIN=
CLOUDFLARE_TUNNEL_TOKEN=
# ava-labs icm-relayer image tag (Fuji after the Helicon upgrade needs ≥ v1.8)
ICM_RELAYER_VERSION=v1.8.4
